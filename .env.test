# Testing environment overrides for ModernAppTemplate backend
FLASK_ENV=testing

# S3 configuration for tests: the environment's local S3 sidecar (MinIO on
# localhost:9000, see ../.kubecoder/config.yaml), not the shared Ceph cluster.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=modern-app-template-test
