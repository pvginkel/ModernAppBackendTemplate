# Testing environment overrides for ModernAppTemplate backend
FLASK_ENV=testing

# S3 configuration for tests: the environment's local S3 sidecar (the
# `s3storage` catalog service, RustFS on localhost:9000, see the parent repo's
# .kubecoder/config.yaml), not the shared Ceph cluster.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=s3storage
S3_SECRET_ACCESS_KEY=s3storage
S3_BUCKET_NAME=modern-app-template-test
